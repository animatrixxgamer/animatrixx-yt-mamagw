# ══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your real values.
#  NEVER commit the resulting .env — it holds live credentials.
# ══════════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=your_bot_token_here
# Your numeric id, from @userinfobot
OWNER_ID=your_user_id_here

# The same two values under the names the src/ package expects.
# Only needed if you run the src/ app instead of bot.py.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_AUTHORIZED_USER_IDS=your_user_id_here

# ── YouTube OAuth 2.0 ──────────────────────────────────────────────
# From console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# This exact URL must be listed under "Authorized redirect URIs" on the
# OAuth client, or Google rejects the authorization request. bot.py serves
# /oauth/callback, /oauth/youtube/callback and /connect, and rewrites a
# localhost port here to match PORT so the two can't drift apart.
# On Railway/Render use the public URL, e.g.
#   https://<your-app>.up.railway.app/oauth/youtube/callback
# Values are .strip()ed on load, so a pasted trailing newline is harmless.
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth/youtube/callback

# NOTE: there are deliberately NO global YOUTUBE_REFRESH_TOKEN /
# YOUTUBE_CHANNEL_ID settings. Every Telegram user connects their OWN channel
# and the tokens live encrypted in the youtube_channels table (see
# OAUTH_MULTIUSER.md). Setting those two variables has no effect.

# ── Config precedence ──────────────────────────────────────────────
# Real environment variables win over this file by default (standard
# behaviour, and it is how hosting dashboards are meant to work). If your
# host has a stale BOT_TOKEN pinned in its dashboard and you want the value
# above to win instead, set:
# PREFER_ENV_FILE=1

# ── Runtime ────────────────────────────────────────────────────────
# Port for the built-in keep-alive web server + OAuth callback.
# Most hosts inject PORT themselves, and their value wins over this one.
# Empty or 0 values are ignored (falls back to 8080).
PORT=8080

# ── Social downloads (yt-dlp) ──────────────────────────────────────
# Optional Netscape cookies file. TikTok/Instagram block many data-center
# IPs; exporting cookies from your browser into this file usually fixes it.
# SOCIAL_COOKIES_FILE=storage/cookies.txt
# SOCIAL_MAX_DURATION=600
# SOCIAL_MAX_HEIGHT=1080

# ── TikTok → YouTube auto posting ──────────────────────────────────
# TIKTOK_POLL_SECONDS=900
# TIKTOK_MAX_PER_RUN=3

# ── Background workers ─────────────────────────────────────────────
# SCHEDULER_TICK_SECONDS=30
# MAX_JOB_RETRIES=3
# Set to 1 to skip the pip auto-install on startup (offline/read-only hosts).
# SKIP_AUTO_INSTALL=0

# ── Public URL (OAuth) ─────────────────────────────────────────────
# Used to show/verify the redirect URI in /diag. Auto-detected on Render and
# from YOUTUBE_REDIRECT_URI otherwise.
# PUBLIC_BASE_URL=https://your-app.onrender.com
