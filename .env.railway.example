# ══════════════════════════════════════════════════════════════════
#  RAILWAY — paste these into the service's "Variables" tab.
#
#  Railway/Render/Heroku environment variables WIN over the bundled .env file
#  (bot.py only lets .env win when PREFER_ENV_FILE=1), so this is the place
#  that actually controls the deployed bot.
#
#  Replace every <...> placeholder with your real value.
# ══════════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────────────
BOT_TOKEN=<your bot token from @BotFather>
OWNER_ID=<your numeric telegram id from @userinfobot>

# ── YouTube OAuth 2.0 ──────────────────────────────────────────────
YOUTUBE_CLIENT_ID=<...apps.googleusercontent.com>
YOUTUBE_CLIENT_SECRET=<GOCSPX-...>

# THIS is the one that must match Google Cloud byte-for-byte.
# It must be listed under "Authorized redirect URIs" on the OAuth client.
YOUTUBE_REDIRECT_URI=https://animatrixx-yt-manager.up.railway.app/oauth/youtube/callback

# ── Persistent storage (REQUIRED) ──────────────────────────────────
# Railway wipes the container filesystem on every deploy. Without a volume the
# SQLite database — and therefore every connected YouTube channel — is deleted
# on each redeploy, which shows up as "channels=0".
#
# 1. Service → Settings → Volumes → New Volume, mount path: /data
# 2. Then set:
STORAGE_DIR=/data

# (If you attach the volume, Railway also exports RAILWAY_VOLUME_MOUNT_PATH and
#  bot.py picks it up automatically, so this line is belt-and-braces.)

# ── Optional ───────────────────────────────────────────────────────
# PORT is injected by Railway automatically — do NOT set it.
# SKIP_AUTO_INSTALL=1
# SCHEDULER_TICK_SECONDS=30
# TIKTOK_POLL_SECONDS=900
# MAX_JOB_RETRIES=3

# ── DO NOT SET THESE ───────────────────────────────────────────────
# YOUTUBE_REFRESH_TOKEN / YOUTUBE_CHANNEL_ID are single-channel leftovers.
# bot.py never reads them; every user connects their own channel instead.
